{
  "name": "@verbos/core",
  "version": "1.0.0",
  "description": "Core library for VERBOS services — Lambda handlers, DynamoDB base model, Logger, and utilities.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.418.0",
    "@aws-sdk/lib-dynamodb": "^3.1021.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "http-status-codes": "^2.3.0",
    "luxon": "^3.5.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.122",
    "@types/luxon": "^3.4.2",
    "@types/node": "^18.19.76",
    "@types/uuid": "^9.0.4",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "eslint": "^9.4.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "@types/aws-lambda": "^8.10.122"
  },
  "contributors": [
    {
      "name": "Jose Carlos Ramos",
      "email": "jramoscarmenates@gmail.com"
    }
  ],
  "license": "MIT",
  "keywords": [
    "verbos",
    "core",
    "serverless",
    "lambda",
    "dynamodb",
    "typescript",
    "aws"
  ],
  "engines": {
    "npm": ">=9.1.2",
    "node": ">=22"
  }
}
